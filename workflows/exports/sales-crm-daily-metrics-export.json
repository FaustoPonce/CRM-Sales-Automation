            },
            {
              "id": "high_priority_tasks_created",
              "displayName": "high_priority_tasks_created",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": false
            },
            {
              "id": "high_priority_tasks_pending",
              "displayName": "high_priority_tasks_pending",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": false
            },
            {
              "id": "overdue_follow_ups_pending",
              "displayName": "overdue_follow_ups_pending",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": false
            }
          ],
          "matchingColumns": [
            "metric_date"
          ]
        },
        "options": {
          "locationDefine": {
            "values": {
              "headerRow": 1,
              "firstDataRow": 2
            }
          },
          "cellFormat": "RAW",
          "handlingExtraData": "ignoreIt",
          "useAppend": false
        }
      }
    }
  ],
  "connections": {
